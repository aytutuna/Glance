<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationIcon>Glance.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>Glance</Product>
    <Company>Aytu Tuna</Company>
    <Copyright>Copyright (c) 2026 Aytu Tuna</Copyright>
    <Description>Press a key to get an answer to the question on your screen.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Anthropic" Version="13.6.0" />
  </ItemGroup>

</Project>
