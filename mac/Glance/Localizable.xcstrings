    "AlreadyRunning": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance قيد التشغيل بالفعل. اضغط %1$@ لقراءة الشاشة."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance läuft bereits. Drücken Sie %1$@, um den Bildschirm zu lesen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance is already running. Press %1$@ to read the screen."
          }
        },
