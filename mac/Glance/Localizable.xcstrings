    "DragAnswerArea": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب لتحديد المنطقة التي ستظهر فيها الإجابات. اضغط Esc للإلغاء."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ziehen Sie den Bereich auf, in dem Antworten erscheinen sollen. Esc bricht ab."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Drag the area where answers should appear. Esc cancels."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Arrastra para marcar el área donde deben aparecer las respuestas. Esc cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Faites glisser pour définir la zone où les réponses doivent apparaître. Échap pour annuler."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "वह क्षेत्र खींचकर चुनें जहाँ उत्तर दिखने चाहिए। Esc से रद्द करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Seret area tempat jawaban akan muncul. Esc untuk membatalkan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Trascina per indicare l'area in cui devono comparire le risposte. Esc per annullare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "回答を表示する領域をドラッグして選択します。Escキーで取り消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "답변이 표시될 영역을 드래그하세요. Esc 키를 누르면 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep het gebied waar antwoorden moeten verschijnen. Esc annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij, aby zaznaczyć obszar, w którym mają się pojawiać odpowiedzi. Esc anuluje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste a área onde as respostas devem aparecer. Esc cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите мышью область, где должны появляться ответы. Esc отменяет выбор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yanıtların görüneceği alanı sürükleyerek seçin. Esc iptal eder."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "拖动以选择回答显示的区域。按 Esc 取消。"
          }
        }
      }
    },
    "DragReadArea": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اسحب فوق المنطقة المراد قراءتها. اضغط Esc للإلغاء."
          }
        },
        "de": {
