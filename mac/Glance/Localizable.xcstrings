    "CliNotFound": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Glance العثور على الأمر claude. ثبّت Claude CLI، ثم شغّل claude مرة واحدة لتسجيل الدخول، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance findet den Befehl claude nicht. Installieren Sie die Claude CLI, führen Sie einmal claude aus, um sich anzumelden, und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance can't find the claude command. Install the Claude CLI, run claude once to sign in, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance no encuentra el comando claude. Instala Claude CLI, ejecuta claude una vez para iniciar sesión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance ne trouve pas la commande claude. Installez la CLI Claude, exécutez claude une fois pour vous connecter, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance को claude कमांड नहीं मिल रहा। Claude CLI इंस्टॉल करें, साइन इन करने के लिए एक बार claude चलाएँ, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance tidak dapat menemukan perintah claude. Instal Claude CLI, jalankan claude sekali untuk masuk, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance non trova il comando claude. Installa Claude CLI, esegui claude una volta per accedere, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glanceがclaudeコマンドを見つけられません。Claude CLIをインストールし、claudeを一度実行してサインインしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance가 claude 명령을 찾을 수 없습니다. Claude CLI를 설치하고 claude를 한 번 실행하여 로그인한 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance kan de opdracht claude niet vinden. Installeer de Claude CLI, voer claude één keer uit om je in te loggen en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance nie może znaleźć polecenia claude. Zainstaluj Claude CLI, uruchom claude raz, aby się zalogować, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
