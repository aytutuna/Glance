    "NeedsHttps": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج هذا العنوان إلى https. لا يعمل http العادي إلا مع هذا Mac والشبكة المحلية."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Diese Adresse erfordert https. Einfaches http funktioniert nur für diesen Mac und das lokale Netzwerk."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This address needs https. Plain http only works for this Mac and the local network."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esta dirección necesita https. Http simple solo funciona con este Mac y la red local."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Cette adresse nécessite https. Le http simple ne fonctionne que pour ce Mac et le réseau local."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "इस पते के लिए https चाहिए। सादा http केवल इस Mac और स्थानीय नेटवर्क के लिए काम करता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat ini memerlukan https. http biasa hanya berfungsi untuk Mac ini dan jaringan lokal."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Questo indirizzo richiede https. Il semplice http funziona solo per questo Mac e per la rete locale."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアドレスにはhttpsが必要です。通常のhttpはこのMacとローカルネットワークでのみ使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "이 주소에는 https가 필요합니다. 일반 http는 이 Mac과 로컬 네트워크에서만 작동합니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Dit adres vereist https. Gewoon http werkt alleen voor deze Mac en het lokale netwerk."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Ten adres wymaga https. Zwykły http działa tylko dla tego Maca i sieci lokalnej."
          }
        },
        "pt-BR": {
