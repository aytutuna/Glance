    "SettingsNotSaved": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر حفظ ملف الإعدادات، لذا لن يبقى هذا الاختيار بعد إعادة التشغيل."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Einstellungsdatei konnte nicht gespeichert werden. Diese Auswahl geht beim Neustart verloren."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't save the settings file, so this choice won't survive a restart."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo guardar el archivo de configuración, así que este cambio no se conservará al reiniciar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible d'enregistrer le fichier de réglages : ce choix ne sera pas conservé au redémarrage."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सेटिंग फ़ाइल सहेजी नहीं जा सकी, इसलिए यह चुनाव रीस्टार्ट के बाद नहीं रहेगा।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menyimpan file pengaturan, sehingga pilihan ini tidak akan bertahan setelah dimulai ulang."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile salvare il file delle impostazioni, quindi questa scelta andrà persa al riavvio."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "設定ファイルを保存できなかったため、この選択は再起動すると失われます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "설정 파일을 저장할 수 없어 이 선택은 다시 시작하면 유지되지 않습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Het instellingenbestand kon niet worden bewaard, dus deze keuze blijft niet behouden na een herstart."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można zapisać pliku ustawień, więc ten wybór nie przetrwa ponownego uruchomienia."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível salvar o arquivo de configurações, então esta escolha não será mantida após reiniciar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось сохранить файл настроек, поэтому этот выбор не сохранится после перезапуска."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ayar dosyası kaydedilemedi, bu seçim yeniden başlatınca kaybolacak."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法保存设置文件，此选择在重新启动后将丢失。"
          }
        }
      }
    },
