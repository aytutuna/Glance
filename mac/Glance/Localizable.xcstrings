          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取る領域をドラッグして選択します。Escキーで取り消します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽을 영역을 드래그하세요. Esc 키를 누르면 취소됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Sleep over het gebied dat je wilt lezen. Esc annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przeciągnij po obszarze do odczytania. Esc anuluje."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Arraste sobre a área a ser lida. Esc cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выделите мышью область для считывания. Esc отменяет выбор."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Okunacak alanı sürükleyerek seçin. Esc iptal eder."
          }
        },
        "zh-Hans": {
