    "CodexNotFound": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Glance العثور على الأمر codex. ثبّته باستخدام npm install -g @openai/codex، ثم شغّل codex login لتسجيل الدخول، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance findet den Befehl codex nicht. Installieren Sie ihn mit npm install -g @openai/codex, melden Sie sich mit codex login an und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance can't find the codex command. Install it with npm install -g @openai/codex, run codex login to sign in, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance no encuentra el comando codex. Instálalo con npm install -g @openai/codex, ejecuta codex login para iniciar sesión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance ne trouve pas la commande codex. Installez-la avec npm install -g @openai/codex, exécutez codex login pour vous connecter, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance को codex कमांड नहीं मिल रहा। इसे npm install -g @openai/codex से इंस्टॉल करें, साइन इन करने के लिए codex login चलाएँ, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance tidak dapat menemukan perintah codex. Instal dengan npm install -g @openai/codex, jalankan codex login untuk masuk, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance non trova il comando codex. Installalo con npm install -g @openai/codex, esegui codex login per accedere, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glanceがcodexコマンドを見つけられません。npm install -g @openai/codex でインストールし、codex login を実行してサインインしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance가 codex 명령을 찾을 수 없습니다. npm install -g @openai/codex로 설치하고 codex login으로 로그인한 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance kan de opdracht codex niet vinden. Installeer die met npm install -g @openai/codex, voer codex login uit om je in te loggen en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance nie może znaleźć polecenia codex. Zainstaluj je poleceniem npm install -g @openai/codex, zaloguj się poleceniem codex login i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glance não encontra o comando codex. Instale-o com npm install -g @openai/codex, execute codex login para entrar e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance не находит команду codex. Установите её командой npm install -g @openai/codex, выполните codex login для входа и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance codex komutunu bulamıyor. npm install -g @openai/codex ile kurun, oturum açmak için codex login çalıştırın, sonra yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance 找不到 codex 命令。请使用 npm install -g @openai/codex 安装，运行 codex login 登录，然后重试。"
          }
        }
      }
    },
