    "KeyCmdOnly": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفتاح ⌘ مع حرف أو رقم فقط تستخدمه كل التطبيقات. أضف ⌃ أو ⌥ أو ⇧."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ mit nur einem Buchstaben oder einer Ziffer wird von jeder App verwendet. Fügen Sie ⌃, ⌥ oder ⇧ hinzu."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ with just a letter or number is used by every app. Add ⌃, ⌥ or ⇧."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ con solo una letra o un número lo usan todas las apps. Agrega ⌃, ⌥ o ⇧."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ avec une simple lettre ou un chiffre est utilisé par toutes les apps. Ajoutez ⌃, ⌥ ou ⇧."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "केवल अक्षर या संख्या के साथ ⌘ हर ऐप में उपयोग होता है। ⌃, ⌥ या ⇧ जोड़ें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ dengan hanya satu huruf atau angka digunakan oleh setiap app. Tambahkan ⌃, ⌥ atau ⇧."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ con una sola lettera o un solo numero è usato da ogni app. Aggiungi ⌃, ⌥ o ⇧."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘と文字または数字だけの組み合わせは、すべてのアプリで使用されます。⌃、⌥、⇧のいずれかを追加してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘와 문자 또는 숫자만 조합한 키는 모든 앱에서 사용됩니다. ⌃, ⌥ 또는 ⇧를 추가하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ met alleen een letter of cijfer wordt door elk programma gebruikt. Voeg ⌃, ⌥ of ⇧ toe."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Skrót ⌘ z samą literą lub cyfrą jest używany przez każdą aplikację. Dodaj ⌃, ⌥ lub ⇧."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "⌘ com apenas uma letra ou um número é usado por todos os apps. Adicione ⌃, ⌥ ou ⇧."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сочетание ⌘ только с буквой или цифрой используется во всех приложениях. Добавьте ⌃, ⌥ или ⇧."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Yalnızca ⌘ ile harf veya rakam her uygulamada kullanılır. ⌃, ⌥ veya ⇧ ekleyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "所有 App 都会使用 ⌘ 加单个字母或数字的组合。请再加上 ⌃、⌥ 或 ⇧。"
          }
        }
      }
    },
    "KeyHeld": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن استخدام %1$@. يستخدمه macOS أو برنامج آخر."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kann nicht verwendet werden. macOS oder ein anderes Programm belegt die Taste."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ can't be used. macOS or another program holds it."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ no se puede usar. macOS u otro programa lo tiene reservado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ne peut pas être utilisée. macOS ou un autre programme la réserve."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ का उपयोग नहीं हो सकता। macOS या कोई अन्य प्रोग्राम इसे इस्तेमाल कर रहा है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ tidak dapat digunakan. macOS atau program lain sedang menggunakannya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile usare %1$@. È già in uso da macOS o da un altro programma."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@は使用できません。macOSまたは別のプログラムが使用しています。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 키를 사용할 수 없습니다. macOS 또는 다른 앱에서 사용 중입니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kan niet worden gebruikt. macOS of een ander programma gebruikt het al."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można użyć %1$@. Skrót jest zajęty przez system macOS lub inny program."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível usar %1$@. O macOS ou outro programa a está usando."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ нельзя использовать. Эта комбинация занята macOS или другой программой."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ kullanılamıyor. macOS veya başka bir program bu tuşu kullanıyor."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法使用 %1$@。macOS 或其他程序已占用该按键。"
          }
        }
      }
    },
