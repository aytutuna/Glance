    "BaseUrlPlain": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plain http address would send the API key unencrypted. Use https, or an address on this Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz http adresi API anahtarını şifrelemeden gönderir. https kullanın veya bu Mac'teki bir adres girin."
          }
        }
      }
    },
    "BaseUrlQuery": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take everything from ? or # onwards out of the base URL."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel URL'de ? veya # işaretinden sonrasını çıkarın."
          }
        }
      }
    },
    "BaseUrlScheme": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The base URL must start with http:// or https://."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel URL http:// veya https:// ile başlamalı."
