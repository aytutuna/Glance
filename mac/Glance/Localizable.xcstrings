    "Declined": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رفض %1$@ الإجابة عن هذا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat die Antwort auf diese Frage abgelehnt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ declined to answer this one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ rechazó responder a esta."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a refusé de répondre à cette demande."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ने इसका उत्तर देने से मना कर दिया।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menolak menjawab yang satu ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha rifiutato di rispondere a questa richiesta."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@はこの質問への回答を拒否しました。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 이 요청에 대한 답변을 거부했습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ weigerde hier antwoord op te geven."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ odmawia odpowiedzi na to pytanie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ se recusou a responder a esta."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ отказался отвечать на этот запрос."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ bu soruyu yanıtlamayı reddetti."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 拒绝回答此问题。"
          }
        }
      }
