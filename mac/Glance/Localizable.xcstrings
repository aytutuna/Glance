    "CantReach": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذر الوصول إلى %1$@. تحقق من الاتصال والعنوان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ist nicht erreichbar. Überprüfen Sie die Verbindung und die Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't reach %1$@. Check the connection and the address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pudo conectar con %1$@. Comprueba la conexión y la dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de joindre %1$@. Vérifiez la connexion et l'adresse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ तक नहीं पहुँचा जा सका। कनेक्शन और पता जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak dapat menjangkau %1$@. Periksa koneksi dan alamatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile raggiungere %1$@. Controlla la connessione e l'indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@に接続できませんでした。接続とアドレスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에 연결할 수 없습니다. 연결 상태와 주소를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kan %1$@ niet bereiken. Controleer de verbinding en het adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można połączyć się z %1$@. Sprawdź połączenie i adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não foi possível acessar %1$@. Verifique a conexão e o endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удалось подключиться к %1$@. Проверьте подключение и адрес."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ sunucusuna ulaşılamadı. Bağlantıyı ve adresi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法连接到 %1$@。请检查网络连接和地址。"
          }
        }
      }
    },
