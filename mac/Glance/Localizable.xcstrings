    "SavedKeyUnusable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة مفتاح API المحفوظ من سلسلة المفاتيح. اربط الذكاء الاصطناعي مرة أخرى لإدخال مفتاح جديد."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der gespeicherte API-Schlüssel kann nicht aus dem Schlüsselbund gelesen werden. Verbinden Sie die KI erneut, um einen neuen einzugeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved API key can't be read from the Keychain. Connect the AI again to enter a new one."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se puede leer del llavero la clave de API guardada. Vuelve a conectar la IA para escribir una nueva."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "La clé API enregistrée ne peut pas être lue depuis le trousseau. Reconnectez l'IA pour en saisir une nouvelle."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई API कुंजी कीचेन से पढ़ी नहीं जा सकती। नई कुंजी दर्ज करने के लिए AI को फिर से कनेक्ट करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API tersimpan tidak dapat dibaca dari Rantai Kunci. Hubungkan AI lagi untuk memasukkan kunci baru."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "La chiave API salvata non può essere letta dal Portachiavi. Collega di nuovo l'IA per inserirne una nuova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのAPIキーをキーチェーンから読み取れません。AIに再接続して新しいキーを入力してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 API 키를 키체인에서 읽을 수 없습니다. AI를 다시 연결하여 새 키를 입력하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde API-sleutel kan niet worden gelezen uit de sleutelhanger. Koppel de AI opnieuw om een nieuwe in te voeren."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zapisanego klucza API z Pęku kluczy. Połącz się z AI ponownie, aby wprowadzić nowy."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "A chave de API salva não pode ser lida do Chaveiro. Conecte a IA novamente para digitar uma nova."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённый ключ API не удаётся прочитать из «Связки ключей». Подключите ИИ заново, чтобы ввести новый ключ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı API anahtarı Anahtar Zinciri'nden okunamıyor. Yeni bir anahtar girmek için yapay zekâyı yeniden bağlayın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法从钥匙串读取已保存的 API 密钥。请重新连接 AI 并输入新密钥。"
          }
        }
      }
    },
    "SavedKeysCaption": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "المفاتيح المحفوظة، تُجرَّب بالتتابع عند نفاد أحدها"
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gespeicherte Schlüssel; ist einer aufgebraucht, wird der nächste verwendet"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Saved keys, tried in turn when one runs out"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Claves guardadas; se prueban por turno cuando una se agota"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Clés enregistrées, essayées tour à tour lorsque l'une est épuisée"
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई कुंजियाँ, एक खत्म होने पर बारी-बारी से आज़माई जाती हैं"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tersimpan, dicoba bergantian saat salah satunya habis"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Chiavi salvate, provate a turno quando una si esaurisce"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのキー（1つが上限に達すると順に試します）"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 키, 하나가 소진되면 순서대로 시도"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Bewaarde sleutels, om de beurt geprobeerd als er een op is"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zapisane klucze, używane po kolei, gdy jeden się wyczerpie"
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Chaves salvas, usadas em sequência quando uma se esgota"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Сохранённые ключи, при исчерпании одного используется следующий"
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı anahtarlar, biri tükenince sırayla denenir"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "已保存的密钥，用完后依次尝试"
          }
        }
      }
    },
    "SavedKeysUnreadable": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تعذرت قراءة المفاتيح المحفوظة. أدخل مفتاحًا جديدًا أو أزلها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die gespeicherten Schlüssel können nicht gelesen werden. Geben Sie einen neuen ein oder entfernen Sie sie."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The saved keys can't be read. Enter a new one, or remove them."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se pueden leer las claves guardadas. Escribe una nueva o quítalas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossible de lire les clés enregistrées. Saisissez-en une nouvelle ou supprimez-les."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सहेजी गई कुंजियाँ पढ़ी नहीं जा सकतीं। नई कुंजी दर्ज करें या उन्हें हटा दें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci tersimpan tidak dapat dibaca. Masukkan yang baru, atau hapus."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Impossibile leggere le chiavi salvate. Inseriscine una nuova o rimuovile."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "保存済みのキーを読み取れません。新しいキーを入力するか、削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "저장된 키를 읽을 수 없습니다. 새 키를 입력하거나 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De bewaarde sleutels kunnen niet worden gelezen. Voer een nieuwe in of verwijder ze."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie można odczytać zapisanych kluczy. Wprowadź nowy lub usuń je."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Não é possível ler as chaves salvas. Digite uma nova ou remova-as."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Не удаётся прочитать сохранённые ключи. Введите новый ключ или удалите их."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıtlı anahtarlar okunamıyor. Yeni bir anahtar girin veya bunları silin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "无法读取已保存的密钥。请输入新密钥，或将其移除。"
          }
        }
      }
    },
    "ScreenAccess": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يحتاج Glance إلى إذن لتسجيل الشاشة. اسمح به في إعدادات النظام، ثم حاول مرة أخرى. إذا استمرت المشكلة، فأنهِ Glance وأعد فتحه."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance benötigt die Berechtigung, den Bildschirm aufzunehmen. Erlauben Sie dies in den Systemeinstellungen und versuchen Sie es dann erneut. Funktioniert es immer noch nicht, beenden Sie Glance und öffnen Sie die App erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance needs permission to record the screen. Allow it in System Settings, then try again. If it still doesn't work, quit and reopen Glance."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance necesita permiso para grabar la pantalla. Permítelo en Ajustes del Sistema y vuelve a intentarlo. Si sigue sin funcionar, cierra Glance y ábrelo de nuevo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance a besoin de l'autorisation d'enregistrer l'écran. Autorisez-la dans Réglages Système, puis réessayez. Si cela ne fonctionne toujours pas, quittez Glance et rouvrez-le."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance को स्क्रीन रिकॉर्ड करने की अनुमति चाहिए। सिस्टम सेटिंग्स में इसकी अनुमति दें, फिर दोबारा कोशिश करें। फिर भी काम न करे तो Glance को बंद करके दोबारा खोलें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance memerlukan izin untuk merekam layar. Izinkan di Pengaturan Sistem, lalu coba lagi. Jika masih tidak berfungsi, keluar lalu buka kembali Glance."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance ha bisogno dell'autorizzazione per registrare lo schermo. Consentila in Impostazioni di Sistema, poi riprova. Se continua a non funzionare, esci da Glance e riaprilo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glanceには画面収録の許可が必要です。システム設定で許可してから、もう一度お試しください。それでも動作しない場合は、Glanceを終了して開き直してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance에 화면 기록 권한이 필요합니다. 시스템 설정에서 허용한 다음 다시 시도하세요. 그래도 작동하지 않으면 Glance를 종료한 후 다시 여세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance heeft toestemming nodig om het scherm op te nemen. Sta dit toe in Systeeminstellingen en probeer het dan opnieuw. Als het nog steeds niet werkt, stop je Glance en open je het opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance potrzebuje uprawnienia do nagrywania ekranu. Zezwól na to w Ustawieniach systemowych, a następnie spróbuj ponownie. Jeśli nadal nie działa, zakończ Glance i otwórz go ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glance precisa de permissão para gravar a tela. Permita em Ajustes do Sistema e tente novamente. Se ainda não funcionar, encerre e abra o Glance novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance нужно разрешение на запись экрана. Предоставьте его в Системных настройках и повторите попытку. Если это не помогло, завершите Glance и откройте его снова."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance'in ekranı kaydetmek için izne ihtiyacı var. Sistem Ayarları'ndan izin verin, sonra yeniden deneyin. Yine de çalışmazsa Glance'ten çıkıp yeniden açın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance 需要“屏幕录制”权限。请在“系统设置”中允许，然后重试。如果仍然无效，请退出并重新打开 Glance。"
          }
        }
      }
    },
