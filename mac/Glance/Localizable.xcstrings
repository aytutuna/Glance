          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Essa tecla precisa de ⌃, ⌥ ou ⌘ pressionada junto, a menos que seja uma tecla F."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
