    "OrderNote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "يسأل Glance أول خدمة محددة. عند نفاد حصتها أو رصيدها، تجيب التالية دون سؤال. وبعد 30 دقيقة يعود إلى الأولى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance fragt die erste aktivierte KI. Ist deren Kontingent oder Guthaben aufgebraucht, antwortet die nächste, ohne nachzufragen. Nach 30 Minuten wird wieder die erste verwendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance asks the first ticked AI. When it runs out of usage or credit, the next one answers without asking. After 30 minutes it goes back to the first."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance consulta primero la primera IA marcada. Cuando se agota su uso o su crédito, responde la siguiente sin preguntar. Pasados 30 minutos, vuelve a la primera."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance interroge la première IA cochée. Lorsqu'elle n'a plus de quota ni de crédit, la suivante répond sans que vous ayez à intervenir. Au bout de 30 minutes, Glance revient à la première."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance सबसे पहले चुने गए AI से पूछता है। उसका उपयोग या क्रेडिट खत्म होने पर अगला AI बिना पूछे उत्तर देता है। 30 मिनट बाद यह फिर पहले AI पर लौट जाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance bertanya ke AI pertama yang dicentang. Saat penggunaan atau kreditnya habis, AI berikutnya menjawab tanpa bertanya lagi. Setelah 30 menit, kembali ke yang pertama."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance interroga la prima IA selezionata. Quando ha esaurito l'utilizzo o il credito, risponde la successiva senza chiedere. Dopo 30 minuti si torna alla prima."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glanceはチェックを付けた最初のAIに問い合わせます。使用量またはクレジットが上限に達すると、確認なしで次のAIが回答します。30分後には最初のAIに戻ります。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance는 선택한 첫 번째 AI에 질문합니다. 사용량이나 크레딧이 소진되면 다음 AI가 묻지 않고 답변합니다. 30분 후에는 첫 번째 AI로 돌아갑니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance vraagt de eerste aangevinkte AI. Als het gebruik of tegoed op is, antwoordt de volgende zonder te vragen. Na 30 minuten gaat het terug naar de eerste."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance pyta pierwsze zaznaczone AI. Gdy skończy się limit użycia lub środki, odpowiada następne, bez pytania. Po 30 minutach wraca do pierwszego."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glance consulta a primeira IA marcada. Quando o uso ou o crédito dela acaba, a próxima responde sem perguntar. Após 30 minutos, ele volta à primeira."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance обращается к первому отмеченному ИИ. Когда у него заканчивается лимит или баланс, следующий отвечает без запроса. Через 30 минут Glance возвращается к первому."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance işaretli ilk yapay zekâya sorar. Kullanım hakkı veya kredisi biterse sonraki sormadan yanıtlar. 30 dakika sonra ilkine döner."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance 会先询问第一个勾选的 AI。当它的用量或额度用完时，下一个 AI 会直接接着回答。30 分钟后将回到第一个。"
          }
        }
      }
    },
