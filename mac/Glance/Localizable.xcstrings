    "PickModel": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اختر نموذجًا أو اكتبه. يعرض تحميل النماذج النماذج التي يمكن لهذا المفتاح استخدامها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wählen Sie ein Modell aus oder geben Sie es ein. „Modelle laden“ listet die Modelle auf, die dieser Schlüssel verwenden kann."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pick or type a model. Load models lists the ones this key can use."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Elige o escribe un modelo. Cargar modelos muestra los que puede usar esta clave."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Choisissez ou saisissez un modèle. « Charger les modèles » affiche ceux que cette clé peut utiliser."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "कोई मॉडल चुनें या टाइप करें। मॉडल लोड करें इस कुंजी से उपयोग हो सकने वाले मॉडल दिखाता है।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Pilih atau ketik model. Muat model menampilkan daftar model yang dapat digunakan kunci ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Scegli o digita un modello. Carica modelli elenca quelli che questa chiave può usare."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルを選択するか入力してください。このキーで使えるモデルは「モデルを読み込む」で一覧表示されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "모델을 선택하거나 입력하세요. 모델 불러오기를 누르면 이 키로 사용할 수 있는 모델이 표시됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Kies of typ een model. Met Modellen laden zie je de modellen die deze sleutel kan gebruiken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Wybierz lub wpisz model. Wczytaj modele wyświetla te, których może używać ten klucz."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Escolha ou digite um modelo. Carregar modelos lista os que esta chave pode usar."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Выберите модель или введите её название. Кнопка «Загрузить модели» показывает модели, доступные для этого ключа."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir model seçin veya yazın. Bu anahtarın kullanabildiği modeller için Modelleri al'a basın."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请选择或输入模型。“加载模型”会列出此密钥可用的模型。"
          }
        }
      }
