          }
        }
      }
    },
    "BaseUrlQuery": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "أزل كل ما يبدأ من ? أو # من عنوان URL الأساسي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entfernen Sie alles ab ? oder # aus der Basis-URL."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Take everything from ? or # onwards out of the base URL."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Quita de la URL base todo lo que va desde ? o # en adelante."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Retirez de l'URL de base tout ce qui suit un ? ou un #, y compris ce caractère."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "बेस URL से ? या # से आगे का सब कुछ हटाएँ।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Hapus semua mulai dari ? atau # dari URL dasar."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Rimuovi dall'URL di base tutto ciò che inizia da ? o #."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ベースURLから?または#以降を削除してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "기본 URL에서 ? 또는 # 이후의 내용을 모두 제거하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Haal alles vanaf ? of # uit de basis-URL."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usuń z podstawowego adresu URL wszystko od znaku ? lub #."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Remova da URL base tudo a partir de ? ou #."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удалите из базового URL всё, начиная с ? или #."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Temel URL'de ? veya # işaretinden sonrasını çıkarın."
          }
        },
