    "Redirect": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "رد %1$@ بإعادة توجيه. لا يتبع Glance عمليات إعادة التوجيه، لذا تحقق من العنوان."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ hat mit einer Weiterleitung geantwortet. Glance folgt keinen Weiterleitungen, überprüfen Sie daher die Adresse."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ answered with a redirect. Glance doesn't follow redirects, so check the address."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ respondió con una redirección. Glance no sigue redirecciones; comprueba la dirección."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ a répondu par une redirection. Glance ne suit pas les redirections, vérifiez donc l'adresse."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ने रीडायरेक्ट के साथ उत्तर दिया। Glance रीडायरेक्ट का पालन नहीं करता, इसलिए पता जाँचें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ menjawab dengan pengalihan. Glance tidak mengikuti pengalihan, jadi periksa alamatnya."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ha risposto con un reindirizzamento. Glance non segue i reindirizzamenti, quindi controlla l'indirizzo."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@がリダイレクトで応答しました。Glanceはリダイレクトに従わないため、アドレスを確認してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@에서 리디렉션으로 응답했습니다. Glance는 리디렉션을 따르지 않으므로 주소를 확인하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ antwoordde met een omleiding. Glance volgt geen omleidingen, dus controleer het adres."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ odpowiada przekierowaniem. Glance nie podąża za przekierowaniami, więc sprawdź adres."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ respondeu com um redirecionamento. O Glance não segue redirecionamentos, então verifique o endereço."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ ответил перенаправлением. Glance не переходит по перенаправлениям, поэтому проверьте адрес."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ yönlendirme ile yanıt verdi. Glance yönlendirmeleri izlemez, adresi kontrol edin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ 返回了重定向。Glance 不会跟随重定向，请检查地址。"
          }
        }
      }
    },
