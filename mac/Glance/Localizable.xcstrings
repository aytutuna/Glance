    "KeyHint": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "اضغط ⌃ أو ⌥ أو ⌘ مع مفتاح. تعمل المفاتيح F1 إلى F20 أيضًا بمفردها."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Halten Sie ⌃, ⌥ oder ⌘ zusammen mit einer Taste gedrückt. F1 bis F20 funktionieren auch allein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hold ⌃, ⌥ or ⌘ with a key. F1 to F20 also work on their own."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantén pulsada ⌃, ⌥ o ⌘ junto con una tecla. F1 a F20 también funcionan solas."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Maintenez ⌃, ⌥ ou ⌘ avec une touche. F1 à F20 fonctionnent aussi seules."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "किसी कुंजी के साथ ⌃, ⌥ या ⌘ दबाए रखें। F1 से F20 अकेले भी काम करती हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tahan ⌃, ⌥ atau ⌘ bersama sebuah tombol. F1 hingga F20 juga berfungsi sendiri."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Tieni premuto ⌃, ⌥ o ⌘ insieme a un tasto. F1–F20 funzionano anche da soli."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーと一緒に⌃、⌥、⌘のいずれかを押したままにします。F1〜F20は単独でも使用できます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "키와 함께 ⌃, ⌥ 또는 ⌘를 누르세요. F1~F20은 단독으로도 사용할 수 있습니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Houd ⌃, ⌥ of ⌘ ingedrukt met een toets. F1 tot en met F20 werken ook los."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Przytrzymaj ⌃, ⌥ lub ⌘ razem z klawiszem. Klawisze F1 do F20 działają także osobno."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantenha ⌃, ⌥ ou ⌘ pressionada com uma tecla. As teclas F1 a F20 também funcionam sozinhas."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удерживайте ⌃, ⌥ или ⌘ вместе с клавишей. Клавиши F1–F20 также работают сами по себе."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bir tuşla birlikte ⌃, ⌥ veya ⌘ basılı tutun. F1-F20 tuşları tek başına da çalışır."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "请按住 ⌃、⌥ 或 ⌘ 并按一个键。F1 至 F20 也可单独使用。"
          }
        }
      }
    },
