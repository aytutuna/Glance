        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "प्रॉम्प्ट खाली नहीं हो सकता। डिफ़ॉल्ट के लिए रीसेट करें का उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Prompt tidak boleh kosong. Gunakan Setel ulang untuk bawaan."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il prompt non può essere vuoto. Usa Ripristina per quello predefinito."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "プロンプトは空にできません。既定の内容に戻すには「リセット」を使用してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "프롬프트는 비워 둘 수 없습니다. 기본값을 사용하려면 재설정을 누르세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "De prompt mag niet leeg zijn. Gebruik Herstellen voor de standaardwaarde."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Polecenie nie może być puste. Użyj opcji Resetuj, aby przywrócić domyślne."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O prompt não pode estar vazio. Use Redefinir para voltar ao padrão."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Запрос не может быть пустым. Чтобы вернуть запрос по умолчанию, нажмите «Сбросить»."
