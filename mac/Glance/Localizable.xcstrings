    "ConnectNote": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "تُرسَل لقطات الشاشة التي تقرؤها إلى خدمة الذكاء الاصطناعي التي تختارها هنا."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gelesene Bildschirminhalte werden an die hier ausgewählte KI gesendet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Screenshots you read are sent to the AI you choose here."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Las capturas de pantalla que leas se envían a la IA que elijas aquí."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les captures d'écran lues sont envoyées à l'IA que vous choisissez ici."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "आप जो स्क्रीनशॉट पढ़ते हैं वे यहाँ चुने गए AI को भेजे जाते हैं।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tangkapan layar yang Anda baca dikirim ke AI yang Anda pilih di sini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Gli screenshot che leggi vengono inviati all'IA scelta qui."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "読み取ったスクリーンショットは、ここで選択したAIに送信されます。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "읽은 화면 캡처는 여기서 선택한 AI로 전송됩니다."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Schermafbeeldingen die je laat lezen worden verzonden naar de AI die je hier kiest."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zrzuty ekranu, które odczytujesz, są wysyłane do wybranego tutaj AI."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "As capturas de tela lidas são enviadas à IA que você escolher aqui."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Снимки экрана, которые вы считываете, отправляются выбранному здесь ИИ."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Ekran görüntüleri seçtiğiniz yapay zekâya gönderilir."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "你读取的屏幕截图将发送到你在此选择的 AI。"
          }
        }
      }
    },
