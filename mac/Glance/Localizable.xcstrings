    "GeminiNotFound": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يستطيع Glance العثور على الأمر gemini. ثبّته باستخدام npm install -g @google/gemini-cli، ثم شغّل gemini مرة واحدة لتسجيل الدخول، ثم حاول مرة أخرى."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance findet den Befehl gemini nicht. Installieren Sie ihn mit npm install -g @google/gemini-cli, führen Sie einmal gemini aus, um sich anzumelden, und versuchen Sie es dann erneut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance can't find the gemini command. Install it with npm install -g @google/gemini-cli, run gemini once to sign in, then try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance no encuentra el comando gemini. Instálalo con npm install -g @google/gemini-cli, ejecuta gemini una vez para iniciar sesión y vuelve a intentarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance ne trouve pas la commande gemini. Installez-la avec npm install -g @google/gemini-cli, exécutez gemini une fois pour vous connecter, puis réessayez."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance को gemini कमांड नहीं मिल रहा। इसे npm install -g @google/gemini-cli से इंस्टॉल करें, साइन इन करने के लिए एक बार gemini चलाएँ, फिर दोबारा कोशिश करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance tidak dapat menemukan perintah gemini. Instal dengan npm install -g @google/gemini-cli, jalankan gemini sekali untuk masuk, lalu coba lagi."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance non trova il comando gemini. Installalo con npm install -g @google/gemini-cli, esegui gemini una volta per accedere, poi riprova."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Glanceがgeminiコマンドを見つけられません。npm install -g @google/gemini-cli でインストールし、geminiを一度実行してサインインしてから、もう一度お試しください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance가 gemini 명령을 찾을 수 없습니다. npm install -g @google/gemini-cli로 설치하고 gemini를 한 번 실행하여 로그인한 다음 다시 시도하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance kan de opdracht gemini niet vinden. Installeer die met npm install -g @google/gemini-cli, voer gemini één keer uit om je in te loggen en probeer het dan opnieuw."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance nie może znaleźć polecenia gemini. Zainstaluj je poleceniem npm install -g @google/gemini-cli, uruchom gemini raz, aby się zalogować, i spróbuj ponownie."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "O Glance não encontra o comando gemini. Instale-o com npm install -g @google/gemini-cli, execute gemini uma vez para entrar e tente novamente."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance не находит команду gemini. Установите её командой npm install -g @google/gemini-cli, один раз запустите gemini для входа и повторите попытку."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance gemini komutunu bulamıyor. npm install -g @google/gemini-cli ile kurun, oturum açmak için bir kez gemini çalıştırın, sonra yeniden deneyin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Glance 找不到 gemini 命令。请使用 npm install -g @google/gemini-cli 安装，运行一次 gemini 以登录，然后重试。"
          }
        }
      }
    },
