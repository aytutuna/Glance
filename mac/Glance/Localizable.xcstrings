    "BaseUrlPlain": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "عنوان http العادي سيرسل مفتاح API دون تشفير. استخدم https، أو عنوانًا على هذا Mac."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Eine einfache http-Adresse würde den API-Schlüssel unverschlüsselt senden. Verwenden Sie https oder eine Adresse auf diesem Mac."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A plain http address would send the API key unencrypted. Use https, or an address on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una dirección http simple enviaría la clave de API sin cifrar. Usa https o una dirección de este Mac."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Une adresse http simple enverrait la clé API sans chiffrement. Utilisez https ou une adresse sur ce Mac."
          }
        },
        "hi": {
          "stringUnit": {
            "state": "translated",
            "value": "सादा http पता API कुंजी को बिना एन्क्रिप्ट किए भेजेगा। https या इस Mac का पता उपयोग करें।"
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Alamat http biasa akan mengirim kunci API tanpa enkripsi. Gunakan https, atau alamat di Mac ini."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un indirizzo http semplice invierebbe la chiave API non cifrata. Usa https oppure un indirizzo su questo Mac."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "通常のhttpアドレスではAPIキーが暗号化されずに送信されます。httpsを使用するか、このMac上のアドレスを指定してください。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "일반 http 주소는 API 키를 암호화하지 않고 전송합니다. https를 사용하거나 이 Mac의 주소를 사용하세요."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een gewoon http-adres zou de API-sleutel onversleuteld verzenden. Gebruik https of een adres op deze Mac."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Zwykły adres http wysłałby klucz API bez szyfrowania. Użyj https lub adresu na tym Macu."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Um endereço http simples enviaria a chave de API sem criptografia. Use https ou um endereço neste Mac."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Обычный адрес http передаёт ключ API без шифрования. Используйте https или адрес на этом Mac."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Düz http adresi API anahtarını şifrelemeden gönderir. https kullanın veya bu Mac'teki bir adres girin."
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
