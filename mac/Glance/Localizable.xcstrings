    "PromptEmpty": {
      "localizations": {
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "لا يمكن أن تكون التعليمات فارغة. استخدم إعادة تعيين للعودة إلى الافتراضي."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Der Prompt darf nicht leer sein. Verwenden Sie „Zurücksetzen“ für den Standard."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The prompt can't be empty. Use Reset for the default."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La instrucción no puede estar vacía. Usa Restablecer para volver a la predeterminada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le prompt ne peut pas être vide. Utilisez Réinitialiser pour rétablir celui par défaut."
          }
